#!/usr/bin/env bash
# review-loop: run the review-loop tools inside a repository.
#
#   review-loop init [--vscode]              create REVIEW.md, REVIEW.sweeps, reviews/ and .review-loop.env here (never overwrites);
#                                            --vscode adds editor tasks, sweep hits appear in the Problems panel
#   review-loop sweeps <base> <tip>          mechanical sweeps over the lines a range added (warn-only)
#   review-loop gate <base> <ref> [<ref>..]  fail unless review reports cover every commit of <base>..<ref>
#   review-loop score add|show ...           record and show recall and noise per round
#   review-loop eval case|blind|record|report ...   the eval set: cases, blind runs, recorded runs, the report
#   review-loop doctor                       check the tools, the skills and this repository's setup
#   review-loop version | help
#
# Configuration: a file of shell variable assignments, ./.review-loop.env at the repository root (or the file named by
# $REVIEW_LOOP_CONFIG, for a repository that keeps its review files elsewhere). It may set:
#   REVIEW_FILE     per-repo knowledge for the reviewer (default <root>/REVIEW.md)
#   REVIEW_SWEEPS   this repo's extra sweeps (default <root>/REVIEW.sweeps)
#   REVIEWS_DIR     review reports and score.tsv (default <root>/reviews)
#   EVALS_DIR       eval cases and runs.tsv (default <root>/evals)
#   REVIEW_REQUIRE_PATHS, REVIEW_REQUIRE_LINE   an extra stated check for commits touching some paths (see review-gate.sh)
set -u

self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
home="${REVIEW_LOOP_HOME:-$(cd "$(dirname "$self")/.." && pwd)}"
pp="$home/skills/pre-pr-review/scripts"
ev="$home/skills/review-eval/scripts"

usage() { sed -n '2,21p' "$self" | sed 's/^# \{0,1\}//'; }

top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
cfg="${REVIEW_LOOP_CONFIG:-${top:+$top/.review-loop.env}}"
if [ -n "${cfg:-}" ] && [ -f "$cfg" ]; then set -a; . "$cfg"; set +a; fi

need_repo() { [ -n "$top" ] || { echo "review-loop: not inside a git repository" >&2; exit 2; }; }
cmd="${1:-help}"; [ $# -gt 0 ] && shift

case "$cmd" in
  help|-h|--help) usage ;;
  version) cat "$home/VERSION" 2>/dev/null || echo "unknown" ;;

  init)
    need_repo
    made=0
    mk() { # file, content-source (a file path) or "-" for stdin
      if [ -e "$1" ]; then echo "kept     $1"; else cat "$2" > "$1" && echo "created  $1" && made=1; fi
    }
    mk "$top/REVIEW.md" "$home/REVIEW.example.md"
    mk "$top/REVIEW.sweeps" <(printf '%s\n' \
      '# This repository'"'"'s own sweeps, added to the generic ones. One per line: name ## path globs ## regex (POSIX ERE) ## why' \
      '# example: old-helper ## *.cpp *.h ## old_helper\( ## the helper is being removed; every call is a finding')
    mkdir -p "$top/reviews" && echo "ready    $top/reviews/ (review reports and score.tsv)"
    mk "$top/.review-loop.env" <(printf '%s\n' \
      '# review-loop configuration for this repository (shell variable assignments). Everything here is optional.' \
      '#REVIEW_FILE=$HOME/path/to/REVIEW.md          # keep the per-repo knowledge outside this repository' \
      '#REVIEW_SWEEPS=$HOME/path/to/REVIEW.sweeps' \
      '#REVIEWS_DIR=$HOME/path/to/reviews' \
      '#EVALS_DIR=$HOME/path/to/evals' \
      '#REVIEW_REQUIRE_PATHS='"'"'^(src/api/|docs/api)'"'"'     # commits touching these need a stated check ...' \
      '#REVIEW_REQUIRE_LINE=Casing                    # ... a "Casing: checked" line in a covering report')
    if [ "${1:-}" = "--vscode" ]; then
      mkdir -p "$top/.vscode"
      tasks="$top/.vscode/tasks.json"
      if [ -e "$tasks" ]; then
        tasks="$top/.vscode/review-loop.tasks.json"
        echo "note     .vscode/tasks.json exists: the review-loop tasks are in $tasks, merge them by hand"
      fi
      if [ -e "$tasks" ]; then echo "kept     $tasks"; else
        cat > "$tasks" <<'JSON'
{
  // review-loop tasks: Terminal > Run Task. The sweep hits show up in the Problems panel as warnings.
  "version": "2.0.0",
  "inputs": [
    { "id": "reviewBase", "type": "promptString", "description": "Base ref: what the change is compared with", "default": "origin/main" },
    { "id": "reviewTip", "type": "promptString", "description": "Tip ref", "default": "HEAD" }
  ],
  "tasks": [
    {
      "label": "review-loop: sweeps",
      "type": "shell",
      "command": "review-loop sweeps ${input:reviewBase} ${input:reviewTip}",
      "problemMatcher": {
        "owner": "review-loop",
        "severity": "warning",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": { "regexp": "^\\s+(.+?):(\\d+):\\s+(.*)$", "file": 1, "line": 2, "message": 3 }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "review-loop: gate",
      "type": "shell",
      "command": "review-loop gate ${input:reviewBase} ${input:reviewTip}",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    { "label": "review-loop: score", "type": "shell", "command": "review-loop score show", "problemMatcher": [] },
    { "label": "review-loop: eval report", "type": "shell", "command": "review-loop eval report", "problemMatcher": [] },
    { "label": "review-loop: doctor", "type": "shell", "command": "review-loop doctor", "problemMatcher": [] }
  ]
}
JSON
        echo "created  $tasks"
      fi
    fi
    echo
    echo "Next: edit REVIEW.md (what a failure is here, the guard paths, what to ignore), then ask for a review:"
    echo "  /pre-pr-review <branch>      (in Claude Code; install the skills with install.sh)"
    echo "  review-loop sweeps <base> <tip>"
    echo "Decide whether reviews/ and .review-loop.env are committed or ignored; REVIEW.md and REVIEW.sweeps normally are." ;;

  sweeps)
    need_repo
    [ $# -ge 2 ] || { echo "usage: review-loop sweeps <base> <tip> [sweep-file ...]" >&2; exit 2; }
    base="$1"; tip="$2"; shift 2
    files=("$pp"/sweeps/*.sweeps)
    own="${REVIEW_SWEEPS:-$top/REVIEW.sweeps}"
    [ -f "$own" ] && files+=("$own")
    exec bash "$pp/diff-sweeps.sh" "$base" "$tip" "${files[@]}" "$@" ;;

  gate)
    need_repo
    export REVIEWS_DIR="${REVIEWS_DIR:-$top/reviews}"
    exec bash "$pp/review-gate.sh" "$@" ;;

  score)
    need_repo
    export REVIEWS_DIR="${REVIEWS_DIR:-$top/reviews}"
    exec bash "$pp/review-score.sh" "$@" ;;

  eval)
    need_repo
    export EVALS_DIR="${EVALS_DIR:-$top/evals}" REVIEW_FILE="${REVIEW_FILE:-$top/REVIEW.md}"
    sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
      case)   exec bash "$ev/eval-case.sh" "$@" ;;
      blind)  exec bash "$ev/eval-blind.sh" "$@" ;;
      record) exec bash "$ev/eval-record.sh" "$@" ;;
      report) exec bash "$ev/eval-report.sh" "$@" ;;
      *) echo "usage: review-loop eval case|blind|record|report ..." >&2; exit 2 ;;
    esac ;;

  doctor)
    ok=0; bad=0
    check() { if eval "$2" >/dev/null 2>&1; then echo "ok       $1"; ok=$((ok + 1)); else echo "MISSING  $1"; bad=$((bad + 1)); fi; }
    echo "review-loop $(cat "$home/VERSION" 2>/dev/null || echo '?') at $home"
    check "bash ${BASH_VERSION%%(*}"      'true'
    check "git"                           'git --version'
    check "awk and sed"                   'awk "BEGIN{}" && sed --version || sed -n 1p /dev/null'
    skill_found() { # a skill in any folder Claude Code or VS Code reads
      for base in "$HOME/.claude/skills" "$HOME/.copilot/skills" ${top:+"$top/.claude/skills" "$top/.github/skills"}; do
        [ -f "$base/$1/SKILL.md" ] && return 0
      done
      return 1
    }
    check "skill pre-pr-review installed" 'skill_found pre-pr-review'
    check "skill review-eval installed"   'skill_found review-eval'
    if [ -n "$top" ]; then
      echo "repository $top"
      check "REVIEW.md ($(echo "${REVIEW_FILE:-$top/REVIEW.md}"))" '[ -f "${REVIEW_FILE:-$top/REVIEW.md}" ]'
      check "REVIEW.sweeps (optional)"    '[ -f "${REVIEW_SWEEPS:-$top/REVIEW.sweeps}" ]'
      check "reports directory"           '[ -d "${REVIEWS_DIR:-$top/reviews}" ]'
      [ -d "${EVALS_DIR:-$top/evals}" ] && echo "         $(bash "$ev/eval-case.sh" list 2>/dev/null | wc -l | tr -d ' ') eval case(s)"
    else
      echo "(not inside a git repository: repository checks skipped)"
    fi
    echo "$ok ok, $bad missing"
    [ "$bad" -eq 0 ] ;;

  *) echo "review-loop: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
